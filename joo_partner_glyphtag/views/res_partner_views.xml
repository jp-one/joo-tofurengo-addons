<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_form_inherit_glyphtag" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.glyphtag</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- Name / Address GlyphTag -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.199 -->
                <xpath expr="//notebook" position="inside">

                    <!-- ========================= -->
                    <!-- GlyphTag Tab -->
                    <!-- ========================= -->
                    <page string="Name / Address (GlyphTag)" name="joo_glyphtag_tab">
                        
                        <group>
                            <!-- Flag -->
                            <field name="use_glyphtag" string="Use GlyphTag"/>
                        </group>

                        <group>
                            <group>
                                <!-- Glyph (Name) -->
                                <label for="name_glyph" string="Name (Glyph)"/>
                                <h1 class="mb-0">
                                    <field name="name_glyph"
                                        readonly="1"
                                        class="text-break d-block joo-font"/>
                                </h1>
                            </group>
                            <group invisible="not use_glyphtag">
                                <!-- GlyphTag (Name) -->
                                <label for="name_glyphtag" string="Name (GlyphTag)"/>
                                <h1 class="mb-0">
                                    <field name="name_glyphtag"
                                        widget="text"
                                        options="{'line_breaks': False}"
                                        class="text-break d-block joo-font"
                                        placeholder="GlyphTag for Name"
                                        required="type == 'contact' and use_glyphtag"/>
                                </h1>
                            </group>
                        </group>

                        <group>
                            <!-- Glyph (Address) -->
                            <group>
                                <field name="street_glyph" readonly="1" class="joo-font"/>
                                <field name="street2_glyph" readonly="1" class="joo-font"/>
                                <field name="city_glyph" readonly="1" class="joo-font"/>
                            </group>

                            <!-- GlyphTag (Address) -->
                            <group invisible="not use_glyphtag">
                                <field name="street_glyphtag" placeholder="GlyphTag for Street"/>
                                <field name="street2_glyphtag" placeholder="GlyphTag for Street2"/>
                                <field name="city_glyphtag" placeholder="GlyphTag for City"/>
                            </group>

                        </group>

                    </page>

                </xpath>

                <!-- readonly="use_glyphtag"  -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.L.140-183 -->
                <xpath expr="//form" position="inside">
                    <field name="use_glyphtag" invisible="1"/>
                </xpath>
                <xpath expr="(//field[@name='name'])[1]" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="(//field[@name='name'])[2]" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='street']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='street2']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='city']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>

                <!-- Glyph Tag Enabled -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.139 -->
                <xpath expr="//h1[field[@name='name']]" position="before">
                    <div class="d-flex align-items-baseline w-md-50" invisible="not use_glyphtag">
                        <i class="fa fa-fw me-1 fa-lock text-primary" title="Glyph Tag Enabled"/>
                        <div class="badge rounded-pill text-bg-warning ms-2">Glyph Tag Enabled</div>
                    </div>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
