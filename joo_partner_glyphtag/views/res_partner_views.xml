<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_form_inherit_glyphtag" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.glyphtag</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- Main Form -->
                <xpath expr="//form" position="inside">
                    <field name="use_glyphtag" invisible="1"/>
                </xpath>

                <!-- GlyphTag Editor Button -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.172 -->
                <xpath expr="//div[hasclass('o_address_format')]" position="after">
                    <span/>
                    <button type="object"
                            name="open_joo_partner_glyphtag_editor"
                            class="btn btn-link p-0 text-start align-baseline border-0 text-decoration-none"
                            invisible="use_glyphtag">
                        <div class="d-flex align-items-center text-nowrap">
                            <i class="fa fa-fw me-1 fa-unlock text-primary" title="GlyphTag Disabled"/>
                            <span class="badge rounded-pill text-bg-info ms-1">Open GlyphTag Editor</span>
                        </div>
                    </button>
                    <button type="object"
                            name="open_joo_partner_glyphtag_editor"
                            class="btn btn-link p-0 text-start align-baseline border-0 text-decoration-none"
                            invisible="not use_glyphtag">
                        <div class="d-flex align-items-center text-nowrap">
                            <i class="fa fa-fw me-1 fa-lock text-primary" title="GlyphTag Enabled"/>
                            <span class="badge rounded-pill text-bg-warning ms-1">GlyphTag</span>
                        </div>
                    </button>
                </xpath>

                <!-- Set fields readonly when GlyphTag is active -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.L.140-183 -->
                <xpath expr="(//field[@name='name'])[1]" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="(//field[@name='name'])[2]" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='street']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='street2']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='city']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>

                <!-- Child Contacts Form -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.237 -->
                <xpath expr="//field[@name='child_ids']//form" position="inside">
                    <field name="use_glyphtag" invisible="1"/>
                </xpath>

                <!-- Child Form: GlyphTag Editor Button -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.278 -->
                <xpath expr="//field[@name='child_ids']//form//field[@name='company_id']" position="before">
                    <span/>
                    <button type="object"
                            name="open_joo_partner_glyphtag_editor"
                            class="btn btn-link p-0 text-start align-baseline border-0 text-decoration-none"
                            invisible="use_glyphtag">
                        <div class="d-flex align-items-center text-nowrap">
                            <i class="fa fa-fw me-1 fa-unlock text-primary" title="GlyphTag Disabled"/>
                            <span class="badge rounded-pill text-bg-info ms-1">Open GlyphTag Editor</span>
                        </div>
                    </button>
                    <button type="object"
                            name="open_joo_partner_glyphtag_editor"
                            class="btn btn-link p-0 text-start align-baseline border-0 text-decoration-none"
                            invisible="not use_glyphtag">
                        <div class="d-flex align-items-center text-nowrap">
                            <i class="fa fa-fw me-1 fa-lock text-primary" title="GlyphTag Enabled"/>
                            <span class="badge rounded-pill text-bg-warning ms-1">GlyphTag</span>
                        </div>
                    </button>
                </xpath>

                <!-- Child Form: Set fields readonly when GlyphTag is active -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.244 -->
                <xpath expr="//field[@name='child_ids']//form//field[@name='name']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.L.268-270 -->
                <xpath expr="//field[@name='child_ids']//form//field[@name='street']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='child_ids']//form//field[@name='street2']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='child_ids']//form//field[@name='city']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>

            </field>
        </record>
        
    </data>
</odoo>
