<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_form_inherit_glyphtag" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.glyphtag</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <xpath expr="//form" position="inside">
                    <field name="use_glyphtag" invisible="1"/>
                </xpath>

                <!-- Glyph Tag Enabled -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.139 -->
                <xpath expr="//h1[field[@name='name']]" position="before">
                    <div class="d-flex align-items-baseline w-md-50" invisible="not use_glyphtag">
                        <i class="fa fa-fw me-1 fa-lock text-primary" title="Glyph Tag Enabled"/>
                        <div class="badge rounded-pill text-bg-warning ms-2">Glyph Tag Enabled</div>
                    </div>
                </xpath>

                <!-- readonly="use_glyphtag"  -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.L.140-183 -->
                <xpath expr="(//field[@name='name'])[1]" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="(//field[@name='name'])[2]" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='street']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='street2']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>
                <xpath expr="//field[@name='city']" position="attributes">
                    <attribute name="readonly">use_glyphtag</attribute>
                </xpath>

            </field>
        </record>
        
    </data>
</odoo>
