<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record id="res_partner_child_views_inherit_furigana" model="ir.ui.view">
            <field name="name">res.partner.child.views.inherit.furigana</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- ============================================================= -->
                <!-- Contacts Tab: kanban - add furigana after name                -->
                <!-- ============================================================= -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.214 -->
                <xpath expr="//field[@name='child_ids']//kanban//main/field[@name='type']" position="after">
                    <div t-if="record.furigana.raw_value" class="text-truncate">
                        <field name="furigana"/>
                    </div>
                </xpath>

                <!-- ============================================================= -->
                <!-- Contacts Tab: form - add furigana after name (full width)     -->
                <!-- ============================================================= -->
                <!-- repos/odoo/odoo/addons/base/views/res_partner_views.xml L.245 -->
                <xpath expr="//field[@name='child_ids']//form//h3[field[@name='name']]" position="after">
                    <div class="w-100">
                        <field name="furigana" placeholder="Furigana"/>
                    </div>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
