<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_partner_child_views_inherit_furigana" model="ir.ui.view">
            <field name="name">res.partner.child.views.inherit.furigana</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- ============================================================= -->
                <!-- Contacts Tab: kanban - add furigana after name                -->
                <!-- ============================================================= -->
                <xpath expr="//field[@name='child_ids']//kanban//main/field[@name='name']" position="after">
                    <div class="text-truncate">
                        <field name="furigana"/>
                    </div>
                </xpath>

                <!-- ============================================================= -->
                <!-- Contacts Tab: form - add furigana after name (full width)     -->
                <!-- ============================================================= -->
                <xpath expr="//field[@name='child_ids']//form//field[@name='name']" position="after">
                    <div class="w-100 my-1">
                        <field name="furigana" placeholder="Furigana"/>
                    </div>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
