<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.joo.tofurengo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Furigana Normalization Setting -->
            <!-- repos/odoo/addons/base_setup/views/res_config_settings_views.xml L.105 -->
            <xpath expr="//div[@id='contacts_settings']//block[@name='contacts_setting_container']" position="inside">
                <setting id="joo_furigana_type_setting"
                         help="Select the Furigana Normalization Type.">
                    <field name="joo_furigana_type"/>
                </setting>
            </xpath>

        </field>
    </record>
</odoo>
