<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_form_inherit_glyph_kana" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.glyph.kana</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <xpath expr="//notebook" position="inside">

                    <!-- ========================= -->
                    <!-- Name Tab -->
                    <!-- ========================= -->
                    <page string="Name / Kana" name="kana_name_tab">
                        
                        <group string="Name / Kana">                            
                            
                            <!-- Raw name split -->
                            <group string="Name Split (Raw)">
                                <field name="family_name" readonly="1"/>
                                <field name="given_name" readonly="1" invisible="is_company"/>
                            </group>

                            <!-- IVS name split -->
                            <group string="Name Split (IVS)">
                                <field name="family_name_ivs" class="joo-font" readonly="1"/>
                                <field name="given_name_ivs" class="joo-font" readonly="1" invisible="is_company"/>
                            </group>

                            <!-- Kana -->
                            <group string="Furigana (Kana)">
                                <field name="family_name_kana"/>
                                <field name="given_name_kana" invisible="is_company"/>
                            </group>

                            <!-- Flag -->
                            <field name="use_name_glyphtag"/>

                            <!-- GlyphTag (Name) -->
                            <h1 class="mb-0 w-md-75">
                                <field name="name_glyphtag"
                                    widget="text"
                                    options="{'line_breaks': False}"
                                    class="text-break d-block joo-font"
                                    placeholder="GlyphTag for Name"
                                    required="type == 'contact' and use_name_glyphtag"/>
                            </h1>
                                                    
                            <!-- IVS (Name) -->
                            <h1 class="mb-0 w-md-75">
                                <field name="name_ivs" readonly="1" class="text-break d-block joo-font"/>
                            </h1>

                        </group>

                    </page>

                    <!-- ========================= -->
                    <!-- Address Tab -->
                    <!-- ========================= -->
                    <page string="Address" name="address_tab">

                        <group string="Address">

                            <!-- Flag -->
                            <field name="use_address_glyphtag"/>

                            <!-- Raw address -->
                            <group string="Address Fields">
                                <field name="city"/>
                                <field name="street"/>
                                <field name="street2"/>
                            </group>

                            <!-- GlyphTag (Address) -->
                            <group string="GlyphTag (Address)">
                                <field name="city_glyphtag"/>
                                <field name="street_glyphtag"/>
                                <field name="street2_glyphtag"/>
                            </group>

                            <!-- IVS (Address) -->
                            <group string="IVS (Address)">
                                <field name="city_ivs" readonly="1" class="joo-font"/>
                                <field name="street_ivs" readonly="1" class="joo-font"/>
                                <field name="street2_ivs" readonly="1" class="joo-font"/>
                            </group>

                        </group>

                    </page>

                </xpath>

            </field>
        </record>

    </data>
</odoo>
