<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_form_inherit_glyph_kana" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.glyph.kana</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- Insert Kana fields right after company_type -->
                <xpath expr="//field[@name='company_type']" position="after">
                    <div class="d-flex gap-2 my-1">
                        <field name="family_kana" 
                            placeholder="Family Hiragana" 
                            class="flex-grow-1"/>
                        <field name="given_kana" 
                            placeholder="Given Hiragana" 
                            class="flex-grow-1" 
                            invisible="is_company"/>
                    </div>
                </xpath>

                <xpath expr="//notebook" position="inside">

                    <!-- ========================= -->
                    <!-- Name Tab -->
                    <!-- ========================= -->
                    <page string="Name (GlyphTag)" name="name_glyphtag_tab">
                        
                        <group string="Name">                            
                            
                            <!-- Flag -->
                            <field name="use_name_glyphtag"/>

                            <!-- GlyphTag (Name) -->
                            <group string="GlyphTag (Name)">
                                <h1 class="mb-0 w-md-75">
                                    <field name="name_glyphtag"
                                        widget="text"
                                        options="{'line_breaks': False}"
                                        class="text-break d-block joo-font"
                                        placeholder="GlyphTag for Name"
                                        required="type == 'contact' and use_name_glyphtag"/>
                                </h1>
                            </group>
                                                    
                            <!-- IVS (Name) -->
                            <group string="IVS (Name)">
                                <h1 class="mb-0 w-md-75">
                                    <field name="name_ivs" readonly="1" class="text-break d-block joo-font"/>
                                </h1>
                            </group>

                        </group>

                    </page>

                    <!-- ========================= -->
                    <!-- Address Tab -->
                    <!-- ========================= -->
                    <page string="Address (GlyphTag)" name="address_glyphtag_tab">

                        <group string="Address">

                            <!-- Flag -->
                            <field name="use_address_glyphtag"/>

                            <!-- GlyphTag (Address) -->
                            <group string="GlyphTag (Address)">
                                <field name="city_glyphtag"/>
                                <field name="street_glyphtag"/>
                                <field name="street2_glyphtag"/>
                            </group>

                            <!-- IVS (Address) -->
                            <group string="IVS (Address)">
                                <field name="city_ivs" readonly="1" class="joo-font"/>
                                <field name="street_ivs" readonly="1" class="joo-font"/>
                                <field name="street2_ivs" readonly="1" class="joo-font"/>
                            </group>

                        </group>

                    </page>

                </xpath>

            </field>
        </record>

    </data>
</odoo>
