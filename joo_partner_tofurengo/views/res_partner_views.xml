<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_form_inherit_tofurengo" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.tofurengo</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- notebook の配下に専用タブを作成し、全項目を集約 -->
                <xpath expr="//notebook" position="inside">
                    <page string="Glyph and Kana Info" name="glyph_kana_info">
                        <group>
                            <group string="Furigana Input">
                                <field name="family_name_kana" placeholder="姓（ふりがな）"/>
                                <field name="given_name_kana" placeholder="名（ふりがな）" invisible="is_company"/>
                            </group>
                            <group string="Name Conversion Outputs">
                                <field name="family_name_search" readonly="1"/>
                                <field name="given_name_search" readonly="1" invisible="is_company"/>
                                <field name="family_name_ivs" class="joo-font" readonly="1"/>
                                <field name="given_name_ivs" class="joo-font" readonly="1" invisible="is_company"/>
                            </group>
                        </group>

                    </page>
                    <page string="Address Info" name="glyph_address_info">

                        <group string="Address Conversion Outputs">
                            <group>
                                <field name="city_search" readonly="1"/>
                                <field name="street_search" readonly="1"/>
                                <field name="street2_search" readonly="1"/>
                            </group>
                            <group>
                                <field name="city_ivs" class="joo-font" readonly="1"/>
                                <field name="street_ivs" class="joo-font" readonly="1"/>
                                <field name="street2_ivs" class="joo-font" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
